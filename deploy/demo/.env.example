# Copy to /opt/autograde-demo/.env (chmod 600). Only the demo reads this file.

# Always a -cpu tag; change it with `demo-autograde upgrade vX.Y.Z`, not by hand.
PALMGRADE_AUTOGRADE_IMAGE=ghcr.io/delta-anugrah/autograde:v1.19.0-cpu

APP_ENV=production
FACTORY_TZ=Asia/Jakarta
# Generate once: openssl rand -hex 24
WEBHOOK_SECRET=
INTERNAL_SECRET=

# Built-in image accounts (@autograde.local): paste the two lines scripts/hash-sandi.py prints.
CONSOLE_DEFAULT_HASH=
CONSOLE_SUPPORT_HASH=
CONSOLE_SYNC_INTERVAL_S=300

# AutoERP demo site. Leave empty until the console has been seeded.
ERP_URL=
ERP_API_KEY=
ERP_API_SECRET=
# Named, never left empty: demo.smagri.id carries three companies and defaults to the wrong one.
ERP_COMPANY=PT Sawit Rambang Lestari
# Empty: no AutoERP account can open the support screens of an internet-facing console.
ERP_ALLOWED_ROLES=

LICENSE_ENABLED=false
LICENSE_PUBLIC_KEY=
LICENSE_TOKEN=
