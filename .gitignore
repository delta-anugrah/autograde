# Cursor
#  Cursor is an AI-powered code editor. `.cursorignore` specifies files/directories to
#  exclude from AI features like autocomplete and code analysis. Recommended for sensitive data
#  refer to https://docs.cursor.com/context/ignore-files
.cursorignore
.cursorindexingignore

# Marimo
marimo/_static/
marimo/_lsp/
__marimo__/

# The two Hikrobot MVS SDK subtrees the Dockerfile copies are committed on
# purpose: the release image bakes the SDK in, and GitHub Actions has no other
# way to get it. This repository and the GHCR package it publishes are private
# for that reason. Everything else dropped in sdk/ by hand stays ignored, and
# the negations have to repeat because the generic Python rules further down
# (*.so, lib64/) would otherwise swallow the libraries.
sdk/*
!sdk/.gitkeep
!sdk/lib64/
!sdk/lib64/**
!sdk/MvImport/
!sdk/MvImport/**
# Copying the SDK twice leaves a nested duplicate of the same modules; the code
# imports the flat `MvImport.*` path, so this copy is dead weight.
sdk/MvImport/MvImport/

# Override compose per mesin. Isinya penyimpangan satu PC, bukan rancangan: tes
# 3 line pakai video di MacBook (tanpa GPU, tanpa host networking, konsol 8110),
# atau tes video di PC pabrik. Compose membacanya OTOMATIS, jadi kalau ikut
# ter-commit dia akan jalan juga di PC pabrik dan menimpa setelan kamera di sana.
docker-compose.override.yml
docker-compose.override.yaml

# Sampah Finder macOS. Ikut ter-commit dua kali lewat `git add -A`; berkas ini
# tidak berarti apa-apa di Linux maupun di image, dan berubah tiap kali folder
# dibuka sehingga muncul terus di `git status`.
.DS_Store
