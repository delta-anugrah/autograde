# ============================================================================
# palmgrade-vision — Environment Example
# ============================================================================
# Copy ke .env lalu isi semua value.

# ========================
# App
# ========================
APP_ENV=development
# APP_HOST / APP_PORT sengaja TIDAK ada di sini. Host uvicorn hardcoded 0.0.0.0
# (entrypoint.sh + cli/serve.py), dan APP_PORT di-set docker-compose per line
# (8001/8002/8003). Mengisinya di file ini tidak berefek ke mana pun.

# ========================
# Frontend (CORS)
# ========================
FRONTEND_URL=http://localhost:3050

# ========================
# Backend / Webhook (wajib)
# WEBHOOK_SECRET harus sama persis dengan palmgrade-api/.env
# ========================
ENABLE_WEBHOOK=true
BACKEND_URL=http://localhost:2500
BACKEND_API_VER=/api/v1
WEBHOOK_SECRET=supersecret123

# ========================
# Model (wajib)
# File model di models/release/
# ========================
MODEL_FILE=best_3class_v2.pt

# ========================
# Inference
# ========================
CONF_THRESHOLD=0.75
# Minimum bounding box area (px²) — di bawah ini auto di-reject terlepas label model
MINIMUM_SIZE=460000
# Jalankan YOLO tiap N frame (1 = production)
YOLO_SKIP_FRAMES=1
# Log verbose output model (1/true = aktif)
DEBUG_MODEL_OUTPUT=

# ========================
# Camera
# CAMERA_TYPE: hikrobot (production) | opencv (dev) | photo (testing)
# ========================
CAMERA_TYPE=hikrobot                        # hikrobot | opencv | photo
CAMERA_DEVICE_INDEX=0                       # index webcam (0/1/2) — diabaikan kalau CAMERA_VIDEO_PATH diisi
CAMERA_VIDEO_PATH=                          # path video file, misal: /home/user/test.mp4
CAMERA_WIDTH=320
CAMERA_HEIGHT=240
CAMERA_FPS=30
CAMERA_PHOTO_PATH=                          # wajib diisi kalau CAMERA_TYPE=photo
# Serial kamera per line (Hikrobot, pilih by-serial — cegah rebutan antar line)
LINE_1_CAMERA_SERIAL=
LINE_2_CAMERA_SERIAL=
LINE_3_CAMERA_SERIAL=
# File .mfs (MVS Feature Save) per line — kosong = default config/camera/hikrobot.mfs
LINE_1_FEATURE_FILE=
LINE_2_FEATURE_FILE=
LINE_3_FEATURE_FILE=

# ========================
# Stream (MJPEG) — hanya untuk tampilan, tidak mempengaruhi hasil simpan
# STREAM_FPS decoupled dari CAMERA_FPS (kamera/YOLO tetap di CAMERA_FPS)
# ========================
STREAM_WIDTH=1280
STREAM_HEIGHT=720
STREAM_FPS=12

# ========================
# Line Identification
# UUID machine dari tabel machines di palmgrade-api (PostgreSQL)
# MACHINE_ID dipakai saat run lokal (uvicorn langsung)
# LINE_X_MACHINE_ID dipakai oleh docker-compose per line
# ========================
MACHINE_ID=
LINE_1_MACHINE_ID=
LINE_2_MACHINE_ID=
LINE_3_MACHINE_ID=

# ========================
# ROI Detection Zone
# Kotak area deteksi — hanya objek yang pusatnya di dalam kotak ini yang dihitung.
# (0,0,0,0) = full frame (semua objek dihitung, tanpa batasan area)
# Set nilai spesifik untuk membatasi area deteksi ke region tertentu.
# Kelas TP tidak dicek ROI — selalu dihitung dari manapun.
# ========================
ROI_X1=0
ROI_Y1=0
ROI_X2=0
ROI_Y2=0

# ========================
# Display / Annotation
# ========================
# Dipakai draw_boxes(); frame sensor 2448x2048 butuh nilai jauh lebih besar.
BORDER_THICKNESS=2
FONT_SCALE=0.7
FONT_THICKNESS=2

# ========================
# Batch Upload Cloud (R2 + API cloud) — jalan tiap jam pada menit UPLOAD_MINUTE
# Semua kredensial PLACEHOLDER — isi saat bucket R2 & domain dibuat.
# R2_BUCKET kosong = batch upload nonaktif (aman untuk dev/lokal).
# UPLOAD_API_SECRET = WEBHOOK_SECRET milik API CLOUD (bukan API lokal).
# ========================
UPLOAD_MINUTE=0
UPLOAD_MAX_ITEMS_PER_TICK=2000
UPLOAD_RETENTION_DAYS=7
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
UPLOAD_API_URL=
UPLOAD_API_SECRET=

# ========================
# License Guard (opsional, default: disabled)
# ========================
LIC_ENABLED=false
LIC_SERVER_URL=https://license.example.com
LIC_API_KEY=your-api-key-here
# Ed25519 public key PEM — newline ditulis sebagai \n
LIC_PUBKEY_PEM=-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEA...\n-----END PUBLIC KEY-----
