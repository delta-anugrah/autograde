# ============================================================================
# Ripe Recognition — Environment Example
# ============================================================================
# Copy this file to `.env` and adjust the values.

# ========================
# App Configuration
# ========================
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
RUNNING_PORT=8000

# ========================
# Frontend Configuration
# ========================
FRONTEND_URL=http://localhost:3050

# ========================
# Backend / Webhook
# ========================
ENABLE_WEBHOOK=true
BACKEND_URL=http://localhost:2500
BACKEND_API_VER=/api/v1
WEBHOOK_SECRET=supersecret123

# ========================
# Model Configuration
# ========================
# File model di models/release/ — ganti jika nama file berbeda
MODEL_FILE=best_3class.pt

# ========================
# Inference Configuration
# ========================
CONF_THRESHOLD=0.75
# Minimum bounding box area (px²) — di bawah ini auto di-reject terlepas label model
MINIMUM_SIZE=460000

# ========================
# Camera Configuration
# ========================
CAMERA_WIDTH=320
CAMERA_HEIGHT=240
CAMERA_FPS=30
# Index kamera Hikrobot (0, 1, 2 untuk 3 kamera berbeda)
CAMERA_DEVICE_INDEX=0

# ========================
# Line Identification
# ========================
# UUID machine dari tabel machines di PostgreSQL
MACHINE_ID=

# ========================
# Display / Annotation
# ========================
BORDER_THICKNESS=2
FONT_SCALE=0.7
FONT_THICKNESS=2
ROI_SCALE=0.7

# ========================
# Auto Upload Schedule
# ========================
UPLOAD_HOUR=0
UPLOAD_MINUTE=0
DESTINATION_UPLOAD=/path/to/upload/destination

# ========================
# License Guard
# ========================
# Set LIC_ENABLED=true di production — butuh server URL, API key, dan public key Ed25519
LIC_ENABLED=false
LIC_SERVER_URL=https://license.example.com
LIC_API_KEY=your-api-key-here
# Ed25519 public key PEM — newline ditulis sebagai \n
LIC_PUBKEY_PEM=-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEA...\n-----END PUBLIC KEY-----

# ========================
# Database Configuration
# ========================
# Reserved untuk kompatibilitas, belum dipakai aktif.
POSTGRES_USER=supplier_admin
POSTGRES_PASSWORD=supersecret
POSTGRES_DB=supplier_dashboard
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=supplier_admin
DB_PASSWORD=supersecret
DB_NAME=supplier_dashboard
