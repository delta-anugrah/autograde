# ============================================================================
# autograde — template. Copy ke .env lalu isi.
# Dibaca docker-compose (--env-file) untuk interpolasi ${VAR} per line.
# ============================================================================

# ── App ─────────────────────────────────────────────────────
# APP_HOST/APP_PORT sengaja tidak ada: host hardcoded 0.0.0.0, port di-set
# compose per line (8001/8002/8003). Diisi di sini pun tidak berefek.
APP_ENV=development
FRONTEND_URL=http://localhost:3050

# ── Backend / Webhook ───────────────────────────────────────
# WEBHOOK_SECRET harus sama persis dengan palmgrade-api/.env.
ENABLE_WEBHOOK=true
BACKEND_URL=http://localhost:2500
BACKEND_API_VER=/api/v1
WEBHOOK_SECRET=supersecret123

# ── Model ───────────────────────────────────────────────────
# File di models/release/
MODEL_FILE=best_3class_v2.pt

# ── Inference ───────────────────────────────────────────────
CONF_THRESHOLD=0.75
# Luas bbox minimum (px²) — di bawah ini auto-reject apa pun label model.
MINIMUM_SIZE=460000
# Jalankan YOLO tiap N frame (1 = production).
YOLO_SKIP_FRAMES=1
# Log verbose output model (1/true = aktif).
DEBUG_MODEL_OUTPUT=

# ── Camera ──────────────────────────────────────────────────
# hikrobot (production) | opencv (dev) | photo (testing)
CAMERA_TYPE=hikrobot
# Index webcam — diabaikan kalau CAMERA_VIDEO_PATH atau serial diisi.
CAMERA_DEVICE_INDEX=0
# Path video file, mis. /home/user/test.mp4
CAMERA_VIDEO_PATH=
# true = video diulang terus sampai line di-stop (uji performa). false = diputar sekali.
CAMERA_VIDEO_LOOP=false
CAMERA_WIDTH=320
CAMERA_HEIGHT=240
# Cuma dipakai kamera yang tidak bisa melaporkan lajunya sendiri (webcam, file
# video). Untuk Hikrobot, laju datang dari file .mfs di bawah dan dibaca balik
# dari kamera — angka di sini diabaikan. Ubah fps = ubah .mfs, satu tempat.
CAMERA_FPS=20
# Wajib diisi kalau CAMERA_TYPE=photo. Gambar contoh ikut repo: images/sample_sawit.jpg
CAMERA_PHOTO_PATH=

# Serial Hikrobot per line — pilih by-serial, cegah rebutan antar line.
# Kosong = fallback ke device index.
LINE_1_CAMERA_SERIAL=
LINE_2_CAMERA_SERIAL=
LINE_3_CAMERA_SERIAL=

# File .mfs (MVS Feature Save) per line. Kosong = config/camera/hikrobot.mfs.
# Ini yang menentukan framerate/exposure/gain, bukan CAMERA_FPS.
LINE_1_FEATURE_FILE=
LINE_2_FEATURE_FILE=
LINE_3_FEATURE_FILE=

# ── Stream MJPEG ────────────────────────────────────────────
# Hanya untuk tampilan; tidak mempengaruhi hasil simpan.
STREAM_WIDTH=1280
STREAM_HEIGHT=720
STREAM_FPS=12

# ── Line Identification ─────────────────────────────────────
# UUID dari tabel machines di palmgrade-api.
# MACHINE_ID dipakai saat run lokal (uvicorn langsung),
# LINE_N_MACHINE_ID dipakai docker-compose per line.
MACHINE_ID=
LINE_1_MACHINE_ID=
LINE_2_MACHINE_ID=
LINE_3_MACHINE_ID=

# ── ROI Detection Zone ──────────────────────────────────────
# Hanya objek yang pusatnya di dalam kotak ini yang dihitung.
# (0,0,0,0) = full frame. Kelas TP tidak dicek ROI.
ROI_X1=0
ROI_Y1=0
ROI_X2=0
ROI_Y2=0

# ── Display / Annotation ────────────────────────────────────
# Dipakai draw_boxes(). Frame sensor 2448x2048 butuh nilai jauh lebih besar.
BORDER_THICKNESS=2
FONT_SCALE=0.7
FONT_THICKNESS=2

# ── Batch Upload Cloud (R2 + API cloud) ─────────────────────
# Jalan tiap jam pada menit UPLOAD_MINUTE.
# R2_BUCKET kosong = batch upload nonaktif (aman untuk dev).
# UPLOAD_API_SECRET = WEBHOOK_SECRET milik API CLOUD, bukan API lokal.
UPLOAD_MINUTE=0
UPLOAD_MAX_ITEMS_PER_TICK=2000
# Umur arsip lokal. Retensi hanya menghapus item yang sudah `done` (gambar
# mendarat di R2 DAN API cloud menjawab 2xx), jadi menaikkannya aman untuk data.
# PC pabrik dinaikkan ke 180 (6 bulan) sebagai cadangan; 7 cukup untuk dev.
UPLOAD_RETENTION_DAYS=7
# Lantai sisa disk (GB). Retensi umur saja tidak cukup begitu angka di atas jadi
# hitungan bulan: kalau throughput melampaui perkiraan, disk penuh sebelum item
# tertua jatuh tempo — dan disk penuh bikin grading BERHENTI tersimpan, bukan
# cuma arsipnya meleset. Di bawah lantai ini, `done` tertua dibuang lebih awal.
# 0 = matikan penjaga.
UPLOAD_DISK_MIN_FREE_GB=20
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
UPLOAD_API_URL=
UPLOAD_API_SECRET=

# ── License Guard (opsional, default mati) ──────────────────
LICENSE_ENABLED=false
# OPSIONAL — kunci publik produksi sudah ditanam di image (`core/config.py`),
# jadi PC pabrik tidak perlu mengisi baris ini sama sekali. Isi hanya untuk
# memverifikasi pakai keypair lain (mis. keypair DEV di laptop); nilai di sini
# menang atas kunci bawaan. Ed25519 public key PEM, newline ditulis sebagai \n.
# LICENSE_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEA...\n-----END PUBLIC KEY-----
# Token langganan hasil cetak cloud. Dipasang `palmgrade license <token>`.
# Kosong = PC ini belum dijaga langganan (sengaja lolos, supaya update ke
# versi ini tidak mematikan pabrik yang sedang jalan).
LICENSE_TOKEN=

# ── PLC / ODOT CN-8031 (Modbus-TCP) ──────────────────────────
# Mati secara default. Cuma PC pabrik yang menyalakan ini.
PLC_ENABLED=false
# IP coupler CN-8031. Untuk pabrik Lampung sudah diusulkan ke vendor panel:
# 192.168.100.50 statis, subnet 255.255.255.0 — satu jaringan dengan tiga kamera
# GigE (.10/.11/.12) dan NIC komputer (.100). Selama PLC_ENABLED=false nilai ini
# tidak dipakai sama sekali: start_plc_worker keluar sebelum sempat membacanya.
PLC_HOST=192.168.100.50
PLC_PORT=502
PLC_UNIT_ID=1
# PLC_COIL_BASE dan PLC_COIL_ALIVE SENGAJA tidak ada di sini. Keduanya ditulis
# literal per service di docker-compose.yml (line 1 = base 0 + alive 9, line 2 =
# base 3, line 3 = base 6) karena itu properti fisik line, bukan setelan mesin.
# Menaruhnya di file ini nol pengaruh — literal compose selalu menang.
# 0 = bit alive (coil 9) ditahan ON, sesuai skematik ODOT dan ladder pak Ocit
# yang membaca LEVEL. > 0 = di-toggle tiap sekian ms, HANYA kalau ladder-nya
# diubah jadi menghitung PERUBAHAN. Lihat docs/plc-integration.md.
PLC_ALIVE_TOGGLE_MS=0
# Lebar pulse OK/NG dan jeda WAJIB di antara dua pulse pada coil yang sama.
# BELUM dikonfirmasi pak Ocit — lihat Task 0 dan docs/plc-integration.md.
PLC_PULSE_MS=200
PLC_PULSE_GAP_MS=100
# Berapa banyak pulse boleh NGUTANG per coil = seberapa BASI sinyal boleh jadi,
# bukan kapasitas. Tiap slot menambah (pulse+gap) ms keterlambatan, dan sinyal
# telat menempel ke buah yang salah di belt. 1 = staleness maksimal 300ms.
PLC_QUEUE_MAX=1
# Periode bangun run_loop = RESOLUSI WAKTU sebenarnya dari semua timing di atas.
# PLC_PULSE_MS wajib >= PLC_POLL_MS: pulse yang lebih pendek dari satu tick
# tidak bisa dihasilkan (ON dan OFF-nya jatuh di tick yang sama, PLC tidak
# pernah melihat rising edge-nya). Dilanggar = warning saat start, bukan crash.
PLC_POLL_MS=200
PLC_DI_COUNT=16

# ── Konsol operator (APP_MODE=console, port 8000) ───────────
# Instance ke-4 dari image yang sama: layar operator offline di
# http://localhost:8000/console. Tanpa kamera, tanpa GPU, tanpa PLC.
#
# Di PC PABRIK, arahkan tiga line ke konsol ini supaya palmgrade_api lokal
# tidak perlu hidup lagi (7 → 4 container):
#     BACKEND_URL=http://localhost:8000
# Kontrak event-nya identik dengan palmgrade-api, jadi kode line tidak berubah
# dan OutboxRetryWorker tetap yang menanggung retry saat konsol restart.
#
# Zona waktu pabrik = batas `tanggal_kerja`. Pabrik jalan ~20 jam/hari LEWAT
# tengah malam; kalau ini salah, satu shift terbelah jadi dua tanggal.
FACTORY_TZ=Asia/Jakarta
# Master data pull interval from AutoERP, seconds (the contract says 5 minutes).
# Needs ERP_URL below; empty means the console runs on its last local copy.
CONSOLE_SYNC_INTERVAL_S=300
# Base URL line kamera dilihat dari konsol (port 8001-8003 ditambahkan sendiri).
# ⚠️ Di macOS pakai http://127.0.0.1: `localhost` menunjuk ::1 lebih dulu,
# sedangkan line (dan stub line E2E) cuma mendengarkan IPv4 → "line tidak menjawab".
CONSOLE_LINE_HOST=http://localhost

# ── AutoERP link ────────────────────────────────────────────
# Empty ERP_URL switches the link off (the default); the operator screen runs
# fully without AutoERP.
#
# Key and secret of the integration user, created in AutoERP with:
#   bench --site <site> execute erpnext.palm_mill.setup.create_integration_user \
#     --kwargs '{"email": "autograde@<site>", "full_name": "AutoGrade"}'
# Re-running it rotates the secret.
ERP_URL=
ERP_API_KEY=
ERP_API_SECRET=
# AutoERP Company this mill books against. Empty lets AutoERP use its own
# default company, which is right on a single-company site.
ERP_COMPANY=
